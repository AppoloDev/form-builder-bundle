{
    "name": "appolodev/form-builder-bundle",
    "description": "Moteur de formulaires personnalisés pour Symfony : structure, rendu, réponses et export",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Fredxd",
            "email": "frederic@appolo.fr"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/filesystem": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "AppoloDev\\FormBuilderBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppoloDev\\FormBuilderBundle\\Tests\\": "tests/"
        }
    }
}
