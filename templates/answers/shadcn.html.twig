{#- Rendu des réponses d'un formulaire (bloc `answers_view`), appelé par la fonction Twig
    form_builder_answers(). Variables : answers (structure + valeurs, cf. AnswerGenerator) et
    formAnswer. Remplaçable via `form_builder.answers_template`. -#}
{% block answers_view %}
    <div id="form_builder" class="w-full">
        {% for block in answers %}
            {{ block('renderBlock') }}
        {% endfor %}
    </div>
{% endblock %}

{% block renderBlock %}
    {% if block(block.type) is defined %}
        {{ block(block.type) }}
    {% endif %}
{% endblock %}

{% block FieldSet %}
    <div class="mb-8 rounded-md border border-dashed border-border p-5 md:p-8">
        {% for child in block.children %}
            {% with {block: child} %}
                {{ block('renderBlock') }}
            {% endwith %}
        {% endfor %}
    </div>
{% endblock %}

{% block Repeatable %}
    {% if block.value is not empty %}
        <div class="mb-8 rounded-md border border-dashed border-border p-5 md:p-8">
            {% for v in block.value %}
                <div class="{% if not loop.last %}mb-8 border-b border-dashed border-border pb-8{% endif %}">
                    {% for child in v %}
                        {% with {block: child} %}
                            {{ block('renderBlock') }}
                        {% endwith %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block Title %}
    {% set headingSizes = {h1: 'text-3xl', h2: 'text-2xl', h3: 'text-xl', h4: 'text-lg', h5: 'text-base', h6: 'text-sm'} %}
    {% set heading = block.heading is defined and headingSizes[block.heading] is defined ? block.heading : 'h3' %}
    <div class="mb-8"><{{ heading }} class="{{ headingSizes[heading] }} font-bold text-foreground">{{ block.text }}</{{ heading }}></div>
{% endblock %}

{% block Paragraph %}
    <div class="mb-8"><p class="text-muted-foreground">{{ block.text }}</p></div>
{% endblock %}

{% block AddressInput %}
    {% if block.value is not empty %}
        {% set rendered %}<a href="https://www.google.com/maps/search/?api=1&amp;query={{ block.value|url_encode }}" target="_blank" rel="noopener noreferrer">{{ block.value }}</a>{% endset %}
    {% endif %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block TextInput %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block NumberInput %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block EmailInput %}
    {% if block.value is not empty %}
        {% set rendered %}<a href="mailto:{{ block.value|url_encode }}">{{ block.value }}</a>{% endset %}
    {% endif %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block TelInput %}
    {% if block.value is not empty %}
        {% set rendered %}<a href="tel:{{ block.value|url_encode }}">{{ block.value }}</a>{% endset %}
    {% endif %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block UrlInput %}
    {#- Lien seulement pour http(s) : jamais de schéma javascript: ou data: dans un href. -#}
    {% if block.value is not empty and block.value matches '#^https?://#i' %}
        {% set rendered %}<a href="{{ block.value }}" target="_blank" rel="noopener noreferrer">{{ block.value }}</a>{% endset %}
    {% endif %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block DateTimeInput %}
    {% set format = form_builder_date_format(block) %}

    {% if block.value.date is defined and block.value.date is not empty %}
        <div class="mb-6 grid gap-1 sm:grid-cols-[minmax(0,33%)_1fr] sm:gap-4">
            <div class="font-bold text-muted-foreground">{{ block.label }}</div>
            <div class="text-foreground">{{ block.value.date|date(format) }}</div>
        </div>
    {% else %}
        {{ block('labelAndValue') }}
    {% endif %}
{% endblock %}

{% block TextareaInput %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block FileInput %}
    {% if block.value is iterable and block.value is not empty %}
        {% set files %}{{ block('fileList') }}{% endset %}
        <div class="mb-6 grid gap-1 sm:grid-cols-[minmax(0,33%)_1fr] sm:gap-4">
            <div class="font-bold text-muted-foreground">{{ 'answers.file_label'|trans({}, 'form_builder_bundle') }}</div>
            <div>{{ files }}</div>
        </div>
    {% else %}
        {{ block('labelAndValue') }}
    {% endif %}
{% endblock %}

{% block Select %}
    {% if block.value is iterable and block.value is not empty %}
        {% set rendered %}{{ block('optionList') }}{% endset %}
    {% endif %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block ChoiceGroup %}
    {{ block('Select') }}
{% endblock %}

{% block HourMinuteInput %}
    {{ block('labelAndValue') }}
{% endblock %}

{% block Signature %}
    <div class="mb-8 grid gap-1 sm:grid-cols-[minmax(0,33%)_1fr] sm:gap-4">
        <div class="font-bold text-muted-foreground">{{ block.label }}</div>
        <div>
            {#- Seules les images en data URI sont affichées (jamais d'URL distante ou locale, y compris en PDF). -#}
            {% if block.value is not iterable and block.value is not empty and (block.value ~ '') starts with 'data:image/' %}
                <div class="inline-block rounded-md border border-border">
                    <img src="{{ block.value }}" alt="{{ 'answers.signature_alt'|trans({}, 'form_builder_bundle') }}">
                </div>
            {% else %}
                –
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block labelAndValue %}
    {#- `rendered` : HTML déjà échappé par le bloc appelant (lien, liste...). Toute autre valeur est échappée ici. -#}
    <div class="mb-6 grid gap-1 sm:grid-cols-[minmax(0,33%)_1fr] sm:gap-4">
        <div class="font-bold text-muted-foreground">{{ block.label }}</div>
        <div class="text-foreground">
            {% if rendered is defined and rendered is not empty %}
                {{ rendered }}
            {% elseif block.value is iterable %}
                {{ block.value is empty ? '–' : block.value|join(', ') }}
            {% elseif block.value is not null and block.value is not same as('') %}
                {{ (block.value ~ '')|nl2br }}
            {% else %}
                –
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block fileList %}
    {% for v in block.value %}
        {% if v.file is defined and v.file is not null %}
            {% set filePath = form_builder_file_url(formAnswer, v.file.filename) %}
            {% if v.file.extension is same as('pdf') %}
                <div class="mb-2 flex items-center gap-3 rounded-md border border-dashed border-border bg-card px-4 py-2">
                    <div class="flex h-8 w-8 items-center justify-center text-lg text-muted-foreground"><twig:ux:icon name="ph:file-pdf" class="size-5" /></div>
                    <twig:UI:Shadcn:Button as="a" variant="link" href="{{ filePath }}" download="{{ v.file.originalFilename }}">
                        {{ v.file.originalFilename }}
                    </twig:UI:Shadcn:Button>
                </div>
            {% else %}
                <div class="mb-2 flex items-center rounded-md border border-dashed border-border bg-card px-4 py-2">
                    <a href="{{ filePath }}" download="{{ v.file.originalFilename }}">
                        <img src="{{ filePath }}" alt="{{ v.file.originalFilename }}" class="max-h-40 rounded">
                    </a>
                </div>
            {% endif %}
        {% else %}
            –
        {% endif %}
    {% endfor %}
{% endblock %}

{% block optionList %}
    <ul class="list-disc pl-5">
        {% for v in block.value %}
            <li>{{ v }}</li>
        {% endfor %}
    </ul>
{% endblock %}
