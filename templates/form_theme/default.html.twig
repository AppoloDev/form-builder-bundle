{#- Thème de formulaire par défaut du bundle : HTML simple et classes génériques, sans aucun composant
    d'application. Habille les types propres au form-builder (fieldset, titre, paragraphe, répétable,
    adresse, signature, fichiers répétables, champ conditionnel). Les types Symfony standard (texte,
    choix, date...) restent rendus par le thème de formulaire de l'application. Pour un design system,
    déclarer son propre thème via `form_builder.form_theme` (blocs à surcharger : voir le README).
    Les comportements JS passent par les contrôleurs Stimulus du bundle (form-builder-collection,
    form-builder-file-drop, form-builder-geo-complete, form-builder-sign-area, form-builder-condition) :
    conserver les `data-*` (dont `data-slot` et `data-existing` des vignettes de fichier) et les classes
    `repeatable`, `repeatable--item`, `collec_child`, `repeatable_child`, `remove-container`, `input-delete`. -#}

{%- block fieldset_row -%}
    <div class="fb-fieldset-wrapper">
        <fieldset id="{{ id }}" class="fb-fieldset">
            {%- for child in form %}
                {{- form_row(child) -}}
            {% endfor -%}
        </fieldset>
    </div>
{%- endblock -%}

{%- block title_row -%}
    <div class="fb-title"><{{ heading }} id="{{ id }}">{{ label }}</{{ heading }}></div>
{%- endblock -%}

{%- block paragraph_row -%}
    <div class="fb-paragraph"><p id="{{ id }}">{{ label|nl2br }}</p></div>
{%- endblock -%}

{%- block separator_row -%}
    <div class="fb-separator"><hr id="{{ id }}"></div>
{%- endblock -%}

{%- block repeatable_row -%}
    <div class="repeatable fb-repeatable">
        <div
            data-controller="form-builder-collection"
            data-prototype="{{ block('repeatable_children_prototype')|e('html') }}"
            data-name="__name__"
            {% if attr.maxItems is defined and attr.maxItems is not same as(0) %}data-max-items="{{ attr.maxItems }}"{% endif %}
            data-remove-btn-target=".remove-container"
            data-collection-child-selector=".repeatable_child"
            {% if data is null %}data-add-auto="1"{% endif %}
        >
            {% for field in form.children %}
                <div class="collec_child repeatable_child" data-val="{{ field.vars.name }}">
                    {% with {form: field} %}
                        {{ block('repeatable_child_row') }}
                    {% endwith %}
                </div>
            {% endfor %}
        </div>
    </div>
{%- endblock -%}

{%- block repeatable_children_prototype -%}
    {% with {form: form.vars.prototype} %}
        {{ block('repeatable_child_row') }}
    {% endwith %}
{%- endblock -%}

{%- block repeatable_child_row -%}
    <div class="repeatable--item fb-repeatable-item">
        <div class="fb-repeatable-body">
            {{ form_widget(form) }}
        </div>

        <div class="remove-container"></div>
    </div>

    {% with {label: 'theme.add_item'|trans({}, 'form_builder_bundle')} %}
        {{ block('add_btn') }}
    {% endwith %}
    {{ block('remove_btn') }}
{%- endblock -%}

{%- block add_btn -%}
    <template id="add-btn">
        <div class="fb-add">
            <a href="#" role="button" class="fb-btn fb-btn-add">
                <span aria-hidden="true">+</span>
                {{ label }}
            </a>
        </div>
    </template>
{%- endblock -%}

{%- block remove_btn -%}
    <template id="remove-btn">
        <a href="#" role="button" class="fb-btn fb-btn-remove" title="{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}">
            <span aria-hidden="true">&times;</span>
            <span class="fb-sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}</span>
        </a>
    </template>
{%- endblock -%}

{%- block address_row -%}
    <div class="fb-row">
        {{ form_label(form) }}
        <div data-controller="form-builder-geo-complete">
            {{ form_widget(form) }}
        </div>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{#- Oui / Non : radios natives (soumission et validation inchangées) habillées en boutons, `:checked` = bouton actif. -#}
{%- block yes_no_widget -%}
    <div id="{{ id }}" class="fb-yes-no" role="radiogroup">
        {%- for child in form -%}
            <label for="{{ child.vars.id }}" class="fb-yes-no-option" style="position:relative">
                {{- block('yes_no_input') -}}
                <span>{{ child.vars.label }}</span>
            </label>
        {%- endfor -%}
    </div>
{%- endblock -%}

{%- block yes_no_input -%}
    {%- do child.setRendered() -%}
    <input type="radio" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}" class="fb-yes-no-input"
        style="position:absolute;opacity:0;width:1px;height:1px"
        {%- if child.vars.checked %} checked{% endif %}
        {%- if child.vars.required %} required{% endif %}
        {%- if child.vars.disabled %} disabled{% endif %}
        {%- if not valid %} aria-invalid="true"{% endif %}>
{%- endblock -%}

{%- block signature_row -%}
    <div class="fb-row">
        {{ form_label(form) }}
        <div
            class="fb-signature"
            data-controller="form-builder-sign-area"
            data-form-builder-sign-area-input-value="#{{ form.vars.id }}"
            data-form-builder-sign-area-clear-label-value="{{ 'signature.clear'|trans({}, 'form_builder_bundle') }}"
            data-form-builder-sign-area-modify-label-value="{{ 'signature.modify'|trans({}, 'form_builder_bundle') }}"
        >
            <div data-form-builder-sign-area-target="container" class="fb-signature-pad"></div>

            <div class="fb-signature-input" style="position:absolute;top:0;z-index:-1">
                {{ form_widget(form) }}
            </div>
        </div>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{%- block file_repeatable_row -%}
    {#- Zone de dépôt (contrôleur form-builder-file-drop, modèle reui « progress file upload ») : zone centrée (icône,
        nombre maximum, formats, bouton), puis une ligne par fichier. Chaque fichier choisi ou déposé devient une
        entrée de la collection. Seules les entrées portant un fichier valide sont affichées ; les autres (fichier
        refusé à la validation) ne laissent que leur message d'erreur. -#}
    {%- set fb_max_items = attr.maxItems ?? 0 -%}
    <div class="file-item">
        <hr class="fb-separator">

        <div class="fb-file-group">
            {#- Libellé, aide et marque « requis » du champ ; « Fichiers joints » seulement à défaut de libellé. -#}
            {% if label is same as(false) %}
                <h3>{{ 'theme.attached_files'|trans({}, 'form_builder_bundle') }}</h3>
            {% else %}
                {{ form_label(form) }}
            {% endif %}
            {{ form_help(form) }}
            {{ form_errors(form) }}

            <div
                class="fb-file-drop"
                {{ block('file_drop_controller_attributes') }}
            >
                <div class="fb-file-drop-zone" {{ block('file_drop_zone_attributes') }}>
                    {{ block('file_drop_picker') }}
                    <p class="fb-file-drop-limit">{{ block('file_limit_text') }}</p>
                    <p class="fb-file-drop-formats">{{ block('file_formats_text') }}</p>
                    <button type="button" class="fb-file-drop-add" data-form-builder-file-drop-target="addButton">
                        {{ 'theme.add_file'|trans({}, 'form_builder_bundle') }}
                    </button>
                </div>

                <div class="fb-file-drop-header" data-form-builder-file-drop-target="header" hidden>
                    <h4>{{ block('file_list_title') }}</h4>
                    <button type="button" class="fb-file-drop-clear" data-action="form-builder-file-drop#clear">{{ 'theme.clear_files'|trans({}, 'form_builder_bundle') }}</button>
                </div>

                <div class="fb-file-drop-list" data-form-builder-file-drop-target="list">
                    {{ block('file_repeatable_children') }}
                </div>

                {{ block('file_repeatable_children_errors') }}
                {{ block('file_repeatable_templates') }}
            </div>
        </div>

        <hr class="fb-separator">
    </div>
{%- endblock -%}

{#- Attributs du contrôleur, à poser sur l'élément qui englobe zone, liste et gabarits. -#}
{%- block file_drop_controller_attributes -%}
    data-controller="form-builder-file-drop"
    data-form-builder-file-drop-prototype-value="{{ block('file_repeatable_children_prototype')|e('html') }}"
    data-form-builder-file-drop-max-items-value="{{ attr.maxItems ?? 0 }}"
    data-form-builder-file-drop-accept-value="{{ attr.accept ?? '' }}"
{%- endblock -%}

{#- Attributs de la zone cliquable / de dépôt (`data-dragging` posé pendant un glisser). -#}
{%- block file_drop_zone_attributes -%}
    data-form-builder-file-drop-target="zone"
    data-action="click->form-builder-file-drop#browse dragenter->form-builder-file-drop#dragOver dragover->form-builder-file-drop#dragOver dragleave->form-builder-file-drop#dragLeave drop->form-builder-file-drop#drop"
{%- endblock -%}

{#- Sélecteur natif, masqué : ouvert par un clic dans la zone. -#}
{%- block file_drop_picker -%}
    <input type="file" hidden {% if attr.accept ?? '' %}accept="{{ attr.accept }}"{% endif %} {% if (attr.maxItems ?? 0) != 1 %}multiple{% endif %} data-form-builder-file-drop-target="picker" data-action="change->form-builder-file-drop#pick">
{%- endblock -%}

{#- Entrées déjà présentes : une ligne par fichier valide. -#}
{%- block file_repeatable_children -%}
    {#- Sans espace autour : la liste reste `:empty` tant qu'aucun fichier n'est présent. -#}
    {%- for field in form.children -%}
        {%- if field.file.vars.data is not null and field.file.vars.valid is same as(true) -%}
            {%- with {form: field} -%}
                {{- block('file_repeatable_child_row') -}}
            {%- endwith -%}
        {%- endif -%}
    {%- endfor -%}
{%- endblock -%}

{#- Entrées sans fichier valide : seulement leur erreur, et marquées rendues (sinon form_rest les afficherait). -#}
{%- block file_repeatable_children_errors -%}
    {% for field in form.children %}
        {% if not (field.file.vars.data is not null and field.file.vars.valid is same as(true)) %}
            {{ form_errors(field.file) }}
            {% do field.setRendered %}
        {% endif %}
    {% endfor %}
{%- endblock -%}

{#- Prototype d'une entrée (inputs seuls) : le contrôleur l'insère, masqué, dans une nouvelle ligne. -#}
{%- block file_repeatable_children_prototype -%}
    {{- form_widget(form.vars.prototype) -}}
{%- endblock -%}

{#- Ligne d'un fichier déjà enregistré. Familles d'icône : même table que fileKind() (assets/lib/file_drop.js). -#}
{%- block file_repeatable_child_row -%}
    {%- set fb_file_extension = form.file.vars.data.getClientOriginalExtension()|lower -%}
    {%- set fb_file_kinds = {
        image: ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'heic', 'heif', 'bmp', 'svg'],
        pdf: ['pdf'],
        doc: ['doc', 'docx', 'odt', 'rtf', 'txt'],
        sheet: ['xls', 'xlsx', 'ods', 'csv'],
        slides: ['ppt', 'pptx', 'odp'],
    } -%}
    {%- set fb_file_kind = 'file' -%}
    {%- for fb_kind, fb_extensions in fb_file_kinds -%}
        {%- if fb_file_extension in fb_extensions -%}{%- set fb_file_kind = fb_kind -%}{%- endif -%}
    {%- endfor -%}
    {%- set fb_file = {
        name: form.file.vars.data.getClientOriginalName(),
        index: form.vars.name,
        kind: fb_file_kind,
    } -%}
    {%- set fb_file_inputs -%}{{ form_widget(form) }}{%- endset -%}
    {{- block('file_drop_item') -}}
{%- endblock -%}

{#- Gabarits lus par le contrôleur : ligne vide (fichier ajouté) et icône de chaque famille de fichier. -#}
{%- block file_repeatable_templates -%}
    <template data-form-builder-file-drop-target="itemTemplate">
        {%- with {fb_file: null, fb_file_inputs: ''} -%}{{ block('file_drop_item') }}{%- endwith -%}
    </template>
    {%- for fb_kind in ['image', 'pdf', 'doc', 'sheet', 'slides', 'file'] -%}
        <template data-form-builder-file-drop-target="icon" data-kind="{{ fb_kind }}">{{ block('file_icon') }}</template>
    {%- endfor -%}
{%- endblock -%}

{#- Icône d'une famille de fichier (`fb_kind` : image, pdf, doc, sheet, slides, file). -#}
{%- block file_icon -%}
    <twig:ux:icon name="{{ {image: 'ph:image', pdf: 'ph:file-pdf', doc: 'ph:file-doc', sheet: 'ph:file-xls', slides: 'ph:file-ppt'}[fb_kind] ?? 'ph:file' }}" />
{%- endblock -%}

{#- « 3 images maximum », « 1 fichier maximum », « Ajoutez vos fichiers » (illimité)… selon `attr.fileKind`. -#}
{%- block file_limit_text -%}
    {{- ('theme.file_limit.' ~ (attr.fileKind ?? 'document'))|trans({'%count%': attr.maxItems ?? 0}, 'form_builder_bundle') -}}
{%- endblock -%}

{#- Titre de la liste des fichiers : « Liste des images » ou « Liste des documents ». -#}
{%- block file_list_title -%}
    {{- ('theme.file_list.' ~ (attr.fileKind ?? 'document'))|trans({}, 'form_builder_bundle') -}}
{%- endblock -%}

{#- Formats acceptés : « JPG, PNG, WebP, HEIC… » ou « Images, PDF, Word… ». -#}
{%- block file_formats_text -%}
    {{- ('theme.file_formats.' ~ (attr.fileKind ?? 'document'))|trans({}, 'form_builder_bundle') -}}
{%- endblock -%}

{#- `fb_file` : {name, index, kind} d'un fichier enregistré, ou null pour le gabarit d'un fichier ajouté (le
    contrôleur remplit alors les emplacements preview, name et size). -#}
{%- block file_drop_item -%}
    <div
        class="fb-file-drop-item file_child"
        data-form-builder-file-drop-target="item"
        {% if fb_file %}data-existing data-val="{{ fb_file.index }}"{% endif %}
    >
        <div class="fb-file-drop-preview" data-slot="preview">
            {%- if fb_file -%}{%- with {fb_kind: fb_file.kind} -%}{{ block('file_icon') }}{%- endwith -%}{%- endif -%}
        </div>
        <div class="fb-file-drop-info">
            <span class="fb-file-drop-name" data-slot="name">{{ fb_file ? fb_file.name }}</span>
            <span class="fb-file-drop-size" data-slot="size"></span>
        </div>
        <div hidden data-slot="inputs">{{ fb_file_inputs }}</div>
        <button type="button" class="fb-file-drop-remove" data-action="form-builder-file-drop#remove" title="{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}" aria-label="{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}">×</button>
    </div>
{%- endblock -%}

{#- Champ conditionnel : enveloppe lue par le contrôleur form-builder-condition, qui l'affiche ou le masque
    selon la valeur du champ propriétaire (#owner_id). -#}
{%- block form_builder_conditional_field_row -%}
    <div
        data-controller="form-builder-condition"
        data-form-builder-condition-owner-value="{{ owner_id }}"
        data-form-builder-condition-operator-value="{{ operator }}"
        data-form-builder-condition-option-label-value="{{ option_label }}"
    >
        {{- form_widget(form) -}}
    </div>
{%- endblock -%}
