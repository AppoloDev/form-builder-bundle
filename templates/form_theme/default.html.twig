{#- Thème de formulaire par défaut du bundle : HTML simple et classes génériques, sans aucun composant
    d'application. Habille les types propres au form-builder (fieldset, titre, paragraphe, répétable,
    adresse, signature, fichiers répétables, champ conditionnel). Les types Symfony standard (texte,
    choix, date...) restent rendus par le thème de formulaire de l'application. Pour un design system,
    déclarer son propre thème via `form_builder.form_theme` (blocs à surcharger : voir le README).
    Les comportements JS passent par les contrôleurs Stimulus du bundle (form-builder-collection,
    form-builder-geo-complete, form-builder-sign-area, form-builder-condition) : conserver les
    `data-*` et les classes `repeatable`, `repeatable--item`, `collec_child`, `repeatable_child`,
    `file_child`, `file-name`, `remove-container`, `input-delete`. -#}

{%- block fieldset_row -%}
    <div class="fb-fieldset-wrapper">
        <fieldset id="{{ id }}" class="fb-fieldset">
            {%- for child in form %}
                {{- form_row(child) -}}
            {% endfor -%}
        </fieldset>
    </div>
{%- endblock -%}

{%- block title_row -%}
    <div class="fb-title"><{{ heading }} id="{{ id }}">{{ label }}</{{ heading }}></div>
{%- endblock -%}

{%- block paragraph_row -%}
    <div class="fb-paragraph"><p id="{{ id }}">{{ label|nl2br }}</p></div>
{%- endblock -%}

{%- block repeatable_row -%}
    <div class="repeatable fb-repeatable">
        <div
            data-controller="form-builder-collection"
            data-prototype="{{ block('repeatable_children_prototype')|e('html') }}"
            data-name="__name__"
            {% if attr.maxItems is defined and attr.maxItems is not same as(0) %}data-max-items="{{ attr.maxItems }}"{% endif %}
            data-remove-btn-target=".remove-container"
            data-collection-child-selector=".repeatable_child"
            {% if data is null %}data-add-auto="1"{% endif %}
        >
            {% for field in form.children %}
                <div class="collec_child repeatable_child" data-val="{{ field.vars.name }}">
                    {% with {form: field} %}
                        {{ block('repeatable_child_row') }}
                    {% endwith %}
                </div>
            {% endfor %}
        </div>
    </div>
{%- endblock -%}

{%- block repeatable_children_prototype -%}
    {% with {form: form.vars.prototype} %}
        {{ block('repeatable_child_row') }}
    {% endwith %}
{%- endblock -%}

{%- block repeatable_child_row -%}
    <div class="repeatable--item fb-repeatable-item">
        <div class="fb-repeatable-body">
            {{ form_widget(form) }}
        </div>

        <div class="remove-container"></div>
    </div>

    {% with {label: 'theme.add_item'|trans({}, 'form_builder_bundle')} %}
        {{ block('add_btn') }}
    {% endwith %}
    {{ block('remove_btn') }}
{%- endblock -%}

{%- block add_btn -%}
    <template id="add-btn">
        <div class="fb-add">
            <a href="#" role="button" class="fb-btn fb-btn-add">
                <span aria-hidden="true">+</span>
                {{ label }}
            </a>
        </div>
    </template>
{%- endblock -%}

{%- block remove_btn -%}
    <template id="remove-btn">
        <a href="#" role="button" class="fb-btn fb-btn-remove" title="{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}">
            <span aria-hidden="true">&times;</span>
            <span class="fb-sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">{{ 'theme.remove'|trans({}, 'form_builder_bundle') }}</span>
        </a>
    </template>
{%- endblock -%}

{%- block address_row -%}
    <div class="fb-row">
        {{ form_label(form) }}
        <div data-controller="form-builder-geo-complete">
            {{ form_widget(form) }}
        </div>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{%- block signature_row -%}
    <div class="fb-row">
        {{ form_label(form) }}
        <div
            class="fb-signature"
            data-controller="form-builder-sign-area"
            data-form-builder-sign-area-input-value="#{{ form.vars.id }}"
            data-form-builder-sign-area-clear-label-value="{{ 'signature.clear'|trans({}, 'form_builder_bundle') }}"
            data-form-builder-sign-area-modify-label-value="{{ 'signature.modify'|trans({}, 'form_builder_bundle') }}"
        >
            <div data-form-builder-sign-area-target="container" class="fb-signature-pad"></div>

            <div class="fb-signature-input" style="position:absolute;top:0;z-index:-1">
                {{ form_widget(form) }}
            </div>
        </div>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{%- block file_repeatable_row -%}
    <div class="file-item">
        <hr class="fb-separator">

        <div class="fb-file-group">
            <h3>{{ 'theme.attached_files'|trans({}, 'form_builder_bundle') }}</h3>

            <div
                data-controller="form-builder-collection"
                data-prototype="{{ block('file_repeatable_children_prototype')|e('html') }}"
                data-name="__name__"
                {% if attr.maxItems is defined and attr.maxItems is not same as(0) %}data-max-items="{{ attr.maxItems }}"{% endif %}
                data-remove-btn-target=".remove-container"
                data-collection-child-selector=".file_child"
                data-delete-selector=".input-delete"
            >
                {% for field in form.children %}
                    <div class="collec_child file_child" data-val="{{ field.vars.name }}">
                        {% with {form: field} %}
                            {{ block('file_repeatable_child_row') }}
                        {% endwith %}
                    </div>
                {% endfor %}
            </div>
        </div>

        <hr class="fb-separator">
    </div>
{%- endblock -%}

{%- block file_repeatable_children_prototype -%}
    {% with {form: form.vars.prototype} %}
        {{ block('file_repeatable_child_row') }}
    {% endwith %}
{%- endblock -%}

{%- block file_repeatable_child_row -%}
    <div class="repeatable--item fb-file-item">
        {{ form_label(form.file) }}
        <div class="fb-file-row">
            {% if form.file.vars.data is not null and form.file.vars.valid is same as(true) %}
                <div class="file-name fb-file-name">
                    <span>{{ form.file.vars.data.getClientOriginalName() }}</span>
                    <div hidden>
                        {{ form_widget(form) }}
                    </div>
                </div>
            {% else %}
               <div class="fb-file-input">
                   {{ form_widget(form.file) }}
                   {{ form_errors(form.file) }}
                   {{ form_help(form.file) }}
               </div>
            {% endif %}
            {{ form_rest(form) }}

            <div class="remove-container"></div>
        </div>
    </div>

    {% with {label: 'theme.add_file'|trans({}, 'form_builder_bundle')} %}
        {{ block('add_btn') }}
    {% endwith %}
    {{ block('remove_btn') }}
{%- endblock -%}

{#- Champ conditionnel : enveloppe lue par le contrôleur form-builder-condition, qui l'affiche ou le masque
    selon la valeur du champ propriétaire (#owner_id). -#}
{%- block form_builder_conditional_field_row -%}
    <div
        data-controller="form-builder-condition"
        data-form-builder-condition-owner-value="{{ owner_id }}"
        data-form-builder-condition-operator-value="{{ operator }}"
        data-form-builder-condition-option-label-value="{{ option_label }}"
    >
        {{- form_widget(form) -}}
    </div>
{%- endblock -%}
